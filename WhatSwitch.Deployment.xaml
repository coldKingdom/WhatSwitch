<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="DeploymentWindow" Title="What Switch? — Deploymentguide"
        Width="940" Height="700" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#0B1222" Foreground="#F5F7FF"
        FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#111A2E" />
        <SolidColorBrush x:Key="PanelAlt" Color="#16213A" />
        <SolidColorBrush x:Key="Border" Color="#2C3B60" />
        <SolidColorBrush x:Key="Muted" Color="#9AA9C8" />
        <SolidColorBrush x:Key="Accent" Color="#6C8CFF" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F5F7FF" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F5F7FF" />
            <Setter Property="Background" Value="#253556" />
            <Setter Property="BorderBrush" Value="#3C527F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#31456E" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#F5F7FF" />
            <Setter Property="Background" Value="#0D1629" />
            <Setter Property="BorderBrush" Value="#344568" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="CaretBrush" Value="#F5F7FF" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#101626" />
            <Setter Property="Background" Value="#F4F6FB" />
            <Setter Property="BorderBrush" Value="#53678F" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#101626" />
            <Setter Property="Background" Value="#F4F6FB" />
            <Setter Property="Padding" Value="9,6" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFF" />
                    <Setter Property="Background" Value="#40598D" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#D7DDEB" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#E9EDFA" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFF" />
                    <Setter Property="Background" Value="#2A3D68" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E8ECF7" />
            <Setter Property="Margin" Value="0,5,18,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#E8ECF7" />
            <Setter Property="Margin" Value="0,6,0,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAB7D3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
        <Style x:Key="StepTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F5F7FF" />
            <Setter Property="FontSize" Value="25" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="92" />
            <RowDefinition Height="*" />
            <RowDefinition Height="72" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0E172A" BorderBrush="#263653" BorderThickness="0,0,0,1">
            <Grid Margin="28,18">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Deploymentguide" FontSize="27" FontWeight="Bold" />
                    <TextBlock Text="Intune, verifiering och PSAppDeployToolkit" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="#15362F" CornerRadius="16" Padding="13,6" VerticalAlignment="Center">
                    <TextBlock Text="WHAT SWITCH? 1.5" Foreground="#5FE0B2" FontWeight="Bold" FontSize="11" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="12">
                <ListBox x:Name="StepList" SelectedIndex="0" IsHitTestVisible="False" Background="Transparent" BorderThickness="0" Foreground="#E9EDFA">
                    <ListBoxItem Padding="9">1  Appinformation</ListBoxItem>
                    <ListBoxItem Padding="9">2  Kommandon</ListBoxItem>
                    <ListBoxItem Padding="9">3  Detektering</ListBoxItem>
                    <ListBoxItem Padding="9">4  Intune-krav</ListBoxItem>
                    <ListBoxItem Padding="9">5  Exportläge</ListBoxItem>
                    <ListBoxItem Padding="9">6  Sammanfattning</ListBoxItem>
                </ListBox>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="24">
                <TabControl x:Name="WizardTabs" SelectedIndex="0" Background="Transparent" BorderThickness="0">
                    <TabControl.Resources>
                        <Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed" /></Style>
                    </TabControl.Resources>
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Appinformation" Style="{StaticResource StepTitle}" />
                                <TextBlock Text="Kontrollera informationen som visas i Intune-portalen." Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                                <TextBlock Text="Programnamn" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="AppNameBox" />
                                <TextBlock Text="Version" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="VersionBox" />
                                <TextBlock Text="Utgivare" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="PublisherBox" />
                                <TextBlock Text="Källfil" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="SourceFileBox" IsReadOnly="True" Foreground="#AAB7D3" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Kommandon och kontext" Style="{StaticResource StepTitle}" />
                                <TextBlock Text="Kommandona körs från paketets källmapp." Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                                <TextBlock Text="Installationskommando" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="InstallCommandBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="62" VerticalContentAlignment="Top" />
                                <TextBlock Text="Avinstallationskommando" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="UninstallCommandBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="62" VerticalContentAlignment="Top" />
                                <TextBlock Text="Körkontext" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="InstallBehaviorCombo" SelectedIndex="0" Width="230" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="System" /><ComboBoxItem Content="User" />
                                </ComboBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Sandbox och detektering" Style="{StaticResource StepTitle}" />
                                <TextBlock Text="Installationen måste kunna identifieras med en faktisk MSI-, fil- eller registerregel." Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                                <Border Background="#102A28" BorderBrush="#285D54" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,14,0,8">
                                    <TextBlock x:Name="SandboxStatusText" Text="Sandbox-test har inte körts." TextWrapping="Wrap" Foreground="#9FE1CF" />
                                </Border>
                                <WrapPanel Margin="0,4,0,8">
                                    <Button x:Name="RunSandboxButton" Content="Starta installationstest" Margin="0,0,8,8" />
                                    <Button x:Name="RefreshDetectionButton" Content="Hämta Sandbox-resultat" Margin="0,0,0,8" />
                                </WrapPanel>
                                <TextBlock Text="Föreslagen detektionsregel" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="DetectionCombo" DisplayMemberPath="displayName" />
                                <TextBlock Text="Regeldata (kan redigeras manuellt)" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="DetectionJsonBox" AcceptsReturn="True" TextWrapping="Wrap"
                                         FontFamily="Cascadia Mono, Consolas" FontSize="11" MinHeight="115"
                                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
                                <Button x:Name="ApplyDetectionJsonButton" Content="Använd redigerad regel" HorizontalAlignment="Left" Margin="0,8,0,4" />
                                <CheckBox x:Name="ConfirmDetectionCheck" Content="Jag har granskat och bekräftar den här detektionsregeln" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Intune-krav" Style="{StaticResource StepTitle}" />
                                <TextBlock Text="Välj vilka Windows-enheter paketet får installeras på." Foreground="{StaticResource Muted}" />
                                <TextBlock Text="Arkitektur" Style="{StaticResource FieldLabel}" />
                                <WrapPanel>
                                    <CheckBox x:Name="ArchitectureX86Check" Content="x86" />
                                    <CheckBox x:Name="ArchitectureX64Check" Content="x64" />
                                    <CheckBox x:Name="ArchitectureArm64Check" Content="ARM64" />
                                </WrapPanel>
                                <TextBlock Text="Minsta operativsystem" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="MinimumOsCombo" SelectedIndex="0" Width="260" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="Windows 10 1607" />
                                    <ComboBoxItem Content="Windows 10 1809" />
                                    <ComboBoxItem Content="Windows 10 21H2" />
                                    <ComboBoxItem Content="Windows 11 21H2" />
                                    <ComboBoxItem Content="Windows 11 23H2" />
                                </ComboBox>
                                <TextBlock Text="Standardreturkoder" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="0, 1707 = lyckades&#x0a;3010 = mjuk omstart&#x0a;1641 = hård omstart&#x0a;1618 = försök igen"
                                           Foreground="#C1CBE0" LineHeight="23" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Exportläge" Style="{StaticResource StepTitle}" />
                                <TextBlock Text="Välj paketeringsmodell för den här exporten." Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                                <RadioButton x:Name="DirectModeRadio" IsChecked="True" Margin="0,18,0,5">
                                    <StackPanel><TextBlock Text="Direkt Intune-paket" FontWeight="SemiBold" /><TextBlock Text="Installerfilen och dess analyserade kommandon används direkt." Foreground="{StaticResource Muted}" /></StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="PsadtScriptModeRadio">
                                    <StackPanel><TextBlock Text="PSADT script-only" FontWeight="SemiBold" /><TextBlock Text="Frontend och skript inkluderas; toolkitmodulen måste redan finnas på måldatorn." Foreground="{StaticResource Muted}" TextWrapping="Wrap" /></StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="PsadtCompleteModeRadio">
                                    <StackPanel><TextBlock Text="Komplett PSADT 4.1.8" FontWeight="SemiBold" /><TextBlock Text="Officiell v4-frontend, toolkitmodul och licens inkluderas." Foreground="{StaticResource Muted}" TextWrapping="Wrap" /></StackPanel>
                                </RadioButton>
                                <CheckBox x:Name="IncludeSourceFolderCheck" Content="Ta med övriga filer från installerns källmapp" Margin="0,18,0,0" />
                                <TextBlock x:Name="PsadtStatusText" Text="PSAppDeployToolkit 4.1.8 kontrolleras vid export." Foreground="#9AA9C8" Margin="0,14,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Sammanfattning" Style="{StaticResource StepTitle}" />
                                <TextBlock Text="Granska allt innan deploymentmappen skapas." Foreground="{StaticResource Muted}" />
                                <Border Background="#0D1629" BorderBrush="#344568" BorderThickness="1" CornerRadius="9" Padding="15" Margin="0,14,0,0">
                                    <TextBlock x:Name="SummaryText" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" />
                                </Border>
                                <Border x:Name="ValidationCard" Background="#302716" BorderBrush="#715A28" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,12,0,0" Visibility="Collapsed">
                                    <TextBlock x:Name="ValidationText" Foreground="#FFE5B0" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#0E172A" BorderBrush="#263653" BorderThickness="0,1,0,0">
            <Grid Margin="24,14">
                <TextBlock x:Name="WizardStatusText" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Text="Steg 1 av 6" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelWizardButton" Content="Avbryt" Margin="0,0,8,0" />
                    <Button x:Name="BackWizardButton" Content="Tillbaka" IsEnabled="False" Margin="0,0,8,0" />
                    <Button x:Name="NextWizardButton" Content="Nästa" Background="#5878E5" BorderBrush="#7390F4" />
                    <Button x:Name="ExportWizardButton" Content="Exportera deployment…" Background="#187A5D" BorderBrush="#2BA17E" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
