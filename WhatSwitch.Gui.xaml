<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="MainWindow"
        Title="What Switch? — Installeranalys"
        Width="1160" Height="780" MinWidth="940" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#0B1020" Foreground="#EEF2FF"
        FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#121A2E" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#18223A" />
        <SolidColorBrush x:Key="BorderBrush" Color="#2B3858" />
        <SolidColorBrush x:Key="MutedBrush" Color="#9AA8C7" />
        <SolidColorBrush x:Key="AccentBrush" Color="#6C8CFF" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#829DFF" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#43D6A3" />
        <SolidColorBrush x:Key="WarningBrush" Color="#FFCB6B" />

        <Style TargetType="Button" x:Key="BaseButton">
            <Setter Property="Foreground" Value="#F6F8FF" />
            <Setter Property="Background" Value="#263451" />
            <Setter Property="BorderBrush" Value="#3B4C71" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#324467" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource BaseButton}" />
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D7DEEF" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="#D7DEEF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="#D7DEEF" FontWeight="SemiBold" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Background" Value="#F5F7FF" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="MinWidth" Value="125" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#10182A" />
            <Setter Property="Foreground" Value="#E8EDFA" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#273451" />
            <Setter Property="RowBackground" Value="#10182A" />
            <Setter Property="AlternatingRowBackground" Value="#151F35" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="88" />
            <RowDefinition Height="*" />
            <RowDefinition Height="38" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0E1528" BorderBrush="#222F4D" BorderThickness="0,0,0,1">
            <Grid Margin="30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="46" Height="46" CornerRadius="12" Background="#6C8CFF" VerticalAlignment="Center">
                    <TextBlock Text="WS" FontWeight="Bold" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,0,0">
                    <TextBlock Text="What Switch?" FontSize="23" FontWeight="Bold" />
                    <TextBlock Text="Statisk installeranalys för PowerShell 7.6" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                </StackPanel>
                <Border Grid.Column="2" Background="#132E2A" BorderBrush="#245B4E" BorderThickness="1"
                        CornerRadius="14" Padding="12,5" VerticalAlignment="Center">
                    <TextBlock Text="LOKAL ANALYS" Foreground="{StaticResource SuccessBrush}" FontSize="11" FontWeight="Bold" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,22,24,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="18">
                <ScrollViewer x:Name="InputScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"
                              Padding="0,0,4,0">
                  <StackPanel>
                    <Grid x:Name="DropZone" AllowDrop="True" Height="290" Margin="0,0,0,16">
                        <Rectangle x:Name="DropOutline" RadiusX="12" RadiusY="12" Fill="#10192D"
                                   Stroke="#536A9F" StrokeThickness="2" StrokeDashArray="5,4" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                            <Border Width="62" Height="62" Background="#1D2B4A" CornerRadius="31" HorizontalAlignment="Center">
                                <TextBlock x:Name="DropIcon" Text="↓" FontSize="34" Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0" />
                            </Border>
                            <TextBlock x:Name="DropTitle" Text="Dra en installer hit" FontSize="19" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,17,0,6" />
                            <TextBlock x:Name="DropSubtitle" Text="EXE, MSI, MSP, MSIX eller AppX" Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Text="eller" Foreground="#687797" HorizontalAlignment="Center" Margin="0,17,0,12" />
                            <Button x:Name="BrowseButton" Content="Välj fil…" Style="{StaticResource PrimaryButton}" />
                        </StackPanel>
                    </Grid>

                    <Border x:Name="FileCard" Background="{StaticResource PanelAltBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10"
                            Padding="13" Margin="0,0,0,14" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="FileNameText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="FilePathText" Grid.Row="1" Foreground="{StaticResource MutedBrush}" FontSize="11"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,4,0,0" />
                            <TextBlock x:Name="FileSizeText" Grid.Row="2" Foreground="#7180A0" FontSize="11" Margin="0,3,0,0" />
                        </Grid>
                    </Border>

                    <StackPanel>
                        <CheckBox x:Name="BestEffortCheck" Content="Skanna kandidatswitchar för okända filer" Margin="2,0,0,12" />
                        <CheckBox x:Name="SandboxNetworkCheck" Content="Tillåt nätverk i Sandbox (webbinstallers)"
                                  ToolTip="Avstängt som standard. Aktivera bara för installers som måste hämta innehåll från internet."
                                  Margin="2,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ReanalyzeButton" Content="Analysera igen" IsEnabled="False" />
                            <Button x:Name="ClearButton" Grid.Column="2" Content="Rensa" IsEnabled="False" />
                        </Grid>
                    </StackPanel>
                  </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="14">
                <Grid>
                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
                        <TextBlock Text="⌁" FontSize="54" Foreground="#3C4D72" HorizontalAlignment="Center" />
                        <TextBlock Text="Väntar på en installer" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,7" />
                        <TextBlock Text="Analysresultat och tysta kommandon visas här."
                                   Foreground="{StaticResource MutedBrush}" TextAlignment="Center" />
                    </StackPanel>

                    <ScrollViewer x:Name="ResultsScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="24">
                        <StackPanel>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="EngineText" FontSize="25" FontWeight="Bold"
                                               TextWrapping="Wrap" Margin="0,0,12,0" />
                                    <TextBlock x:Name="ResultFileText" Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap" Margin="0,5,12,0" />
                                </StackPanel>
                                <Border x:Name="ConfidenceBadge" Grid.Column="1" CornerRadius="14" Padding="12,5"
                                        Background="#243251" VerticalAlignment="Top">
                                    <TextBlock x:Name="ConfidenceText" FontSize="11" FontWeight="Bold" />
                                </Border>
                            </Grid>

                            <Border x:Name="MetadataCard" Background="#10182A" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="PRODUKT" Foreground="#7180A0" FontSize="10" FontWeight="Bold" />
                                        <TextBlock x:Name="ProductText" Margin="0,4,12,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="UTGIVARE / VERSION" Foreground="#7180A0" FontSize="10" FontWeight="Bold" />
                                        <TextBlock x:Name="CompanyVersionText" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border x:Name="CatalogCard" Background="#102A28" BorderBrush="#285D54" BorderThickness="1"
                                    CornerRadius="10" Padding="15" Margin="0,0,0,14" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="KATALOGTRÄFF" Foreground="{StaticResource SuccessBrush}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock x:Name="CatalogNameText" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,6" />
                                    <TextBlock x:Name="CatalogInstallText" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                               TextWrapping="Wrap" Foreground="#D6FFF1" />
                                    <TextBlock x:Name="CatalogNoteText" Foreground="#9FC7BD" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="WarningCard" Background="#302716" BorderBrush="#715A28" BorderThickness="1"
                                    CornerRadius="10" Padding="14" Margin="0,0,0,14" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="⚠" Foreground="{StaticResource WarningBrush}" FontSize="18"
                                               Margin="0,0,10,0" VerticalAlignment="Top" />
                                    <TextBlock x:Name="WarningText" Grid.Column="1" Foreground="#FFE5B0"
                                               TextWrapping="Wrap" HorizontalAlignment="Stretch" />
                                </Grid>
                            </Border>

                            <StackPanel Margin="0,4,0,10">
                                <TextBlock Text="Kommandon" FontSize="18" FontWeight="SemiBold" />
                                <WrapPanel HorizontalAlignment="Right" Margin="0,9,0,0">
                                    <ComboBox x:Name="ShellSelector" SelectedIndex="0" Margin="0,0,8,8">
                                        <ComboBoxItem Content="PowerShell" />
                                        <ComboBoxItem Content="CMD" />
                                    </ComboBox>
                                    <Button x:Name="DeploymentGuideButton" Content="Deploymentguide…" Padding="11,6"
                                            IsEnabled="False" Margin="0,0,8,8"
                                            ToolTip="Bygg ett verifierat Intune- eller PSADT-deploymentpaket steg för steg." />
                                    <Button x:Name="CopyJsonButton" Content="Kopiera JSON" Padding="11,6" Margin="0,0,8,8" />
                                    <Button x:Name="SaveJsonButton" Content="Spara JSON…" Padding="11,6" Margin="0,0,0,8" />
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel x:Name="CommandPanel" />

                            <TextBlock Text="Analysnotering" FontSize="16" FontWeight="SemiBold" Margin="0,18,0,6" />
                            <TextBlock x:Name="NotesText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Name="ModifiersText" Foreground="#8190AF" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />

                            <Expander x:Name="CandidatesExpander" Header="Best-effort-kandidater" Margin="0,18,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="CandidatesText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                            </Expander>

                            <Expander x:Name="MsiExpander" Header="MSI-egenskaper" Margin="0,18,0,0" Visibility="Collapsed">
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock x:Name="MsiSummaryText" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" />
                                    <DataGrid x:Name="MsiGrid" AutoGenerateColumns="False" Height="240" AlternationCount="2">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Egenskap" Binding="{Binding Name}" Width="2*" />
                                            <DataGridTextColumn Header="Värde" Binding="{Binding Value}" Width="3*" />
                                            <DataGridCheckBoxColumn Header="Hemlig" Binding="{Binding IsSecret}" Width="70" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#0E1528" BorderBrush="#222F4D" BorderThickness="0,1,0,0">
            <Grid Margin="24,0">
                <TextBlock x:Name="StatusText" Text="Redo — dra in en installer för att börja"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                <ProgressBar x:Name="BusyBar" Width="150" Height="4" HorizontalAlignment="Right"
                             IsIndeterminate="True" Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Window>
